# log.txt must be present before running!

services:
  proxy:
    image: {{ stabvest_proxy_container }}
    ports:
      - "{{ stabvest_port }}:80"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - webserver

  webserver:
    build:
      context: .
      dockerfile: Dockerfile-server
    volumes:
      - .:/app
    environment:
      - PYTHONUNBUFFERED=1
    restart: unless-stopped
    deploy:
      replicas: {{ stabvest_webserver_replicas }}
    depends_on:
      - database
  
  worker:
    build:
      context: .
      dockerfile: Dockerfile-worker
    volumes:
      - .:/app
    environment:
      - PYTHONUNBUFFERED=1
    restart: unless-stopped
    depends_on:
      - database

  database:
    image: {{ stabvest_database_image }}
    restart: always
    environment:
      POSTGRES_USER: {{ stabvest_database_user }}
      POSTGRES_PASSWORD: {{ stabvest_database_password }}
      POSTGRES_DB: {{ stabvest_database_db }}
    expose:
      - "5432" 
    volumes:
      - pgdata:/var/lib/postgresql/data

volumes:
  pgdata: